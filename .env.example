# Email Configuration
GOOGLE_USER_EMAIL=your-gmail@gmail.com
GOOGLE_APP_PASSWORD=your-app-password # Gmail app password (generate after enabling 2FA)

# Groq Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000

# Firebase Admin Configuration (firebase-admin, used by the worker and API)
# Provide one of:
#   FIREBASE_SERVICE_ACCOUNT: full service account JSON string (recommended for CI)
#   FIREBASE_SERVICE_ACCOUNT_PATH: path to a service account JSON key file
# If neither is set, application default credentials are used.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional projectId override; defaults to the service account's project_id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# API Security
NEWSLETTER_JOB_TOKEN=your-shared-secret-token